# =====================================================================
# CONFIGURATION DE L'APPLICATION — ONG & CRM
# =====================================================================

APP_NAME="Espoir d'Avenir - ONG"
APP_ENV=development
APP_DEBUG=true
APP_URL="http://localhost:8000"
APP_CURRENCY="FCFA"
APP_TIMEZONE="Africa/Abidjan"

# =====================================================================
# BASE DE DONNÉES MYSQL
# =====================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ong_crm
DB_USER=root
DB_PASS=

# =====================================================================
# SÉCURITÉ & SESSIONS
# =====================================================================
SESSION_LIFETIME=7200
CSRF_SECRET="change_this_secret_key_in_production_12345"

# =====================================================================
# OPÉRATEURS DE PAIEMENT MOBILE MONEY (SIMULATION & SANDBOX)
# =====================================================================
PAYMENT_MODE=simulation # simulation ou live
WAVE_API_KEY=""
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
MTN_MOMO_PRIMARY_KEY=""
MOOV_MONEY_API_KEY=""

# =====================================================================
# CHATBOT ASSISTANT IA
# =====================================================================
CHATBOT_MODE=smart_rules # smart_rules ou openai
OPENAI_API_KEY=""
